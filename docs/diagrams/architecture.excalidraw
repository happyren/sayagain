          "genre": "architecture",
          "scenarios": [
            {
              "name": "WILCO: a read-only call",
              "description": "The common case. Receipt, classify, no duplicate, no hold, forwarded unchanged, upstream succeeds, answered with a receipt and status executed.",
              "path": [
                "FCDqSkLENFyZ6KJUsUhj",
                "GMAaQlG7iE28JA7m3SBr",
                "Cn9OXQNVMzWOgROJyVsP",
                "3cNB5EhCR95Tx1SjnNia",
                "Dq0jWgbBOKtrRsdCsD1P",
                "bPMJJvlNQFHCmfxvGLNh"
              ]
            },
            {
              "name": "STANDBY: a destructive call held",
              "description": "A destructive tool is held before it leaves. The agent gets a held notice with the receipt; an operator approves; only then is it forwarded and executed once.",
              "path": [
                "FCDqSkLENFyZ6KJUsUhj",
                "GMAaQlG7iE28JA7m3SBr",
                "Cn9OXQNVMzWOgROJyVsP",
                "eF8vcF2V7LQqUQF2Sd6N",
                "rP1ufTh8XkI8xGdjARL6",
                "bBiGDGbMYyu10zpykYwu",
                "Dq0jWgbBOKtrRsdCsD1P",
                "bPMJJvlNQFHCmfxvGLNh"
              ]
            },
            {
              "name": "STANDBY: a write failed with unknown outcome",
              "description": "A write times out. Because the tool is not provably idempotent the boundary holds instead of retrying, and tells the agent so. Nobody double-fires.",
              "path": [
                "FCDqSkLENFyZ6KJUsUhj",
                "GMAaQlG7iE28JA7m3SBr",
                "Cn9OXQNVMzWOgROJyVsP",
                "3cNB5EhCR95Tx1SjnNia",
                "Dq0jWgbBOKtrRsdCsD1P",
                "s0LyNfkq4NXjdbEx9MAr",
                "rP1ufTh8XkI8xGdjARL6"
              ]
            },
            {
              "name": "CORRECTION: a coercible error repaired",
              "description": "The upstream rejects a string where it wanted an integer. A deterministic rule fixes the argument, the repair is recorded in _meta, and the call is forwarded again without a model round trip.",
              "path": [
                "FCDqSkLENFyZ6KJUsUhj",
                "GMAaQlG7iE28JA7m3SBr",
                "Cn9OXQNVMzWOgROJyVsP",
                "3cNB5EhCR95Tx1SjnNia",
                "Dq0jWgbBOKtrRsdCsD1P",
                "9MjcKo3S1V1A5AxxEuid",
                "8Hl9J8i0ISvzNKP2UOFD",
                "bPMJJvlNQFHCmfxvGLNh"
              ]
            },
            {
              "name": "UNABLE: repair budget exhausted",
              "description": "The repair did not help and the budget is spent. The call goes to the dead-letter queue with its intent attached, and the agent is told UNABLE rather than left to loop.",
              "path": [
                "FCDqSkLENFyZ6KJUsUhj",
                "GMAaQlG7iE28JA7m3SBr",
                "Cn9OXQNVMzWOgROJyVsP",
                "3cNB5EhCR95Tx1SjnNia",
                "Dq0jWgbBOKtrRsdCsD1P",
                "9MjcKo3S1V1A5AxxEuid",
                "UhslEZSc9ENw0H3BtH1t",
                "umurtH0Yt3VNF6vd8OWt"
              ]
            },
            {
              "name": "DISREGARD: a duplicate call",
              "description": "The same idempotency key or the same tool and arguments arrive again inside the window. Nothing is forwarded; the first result is reproduced.",
              "path": [
                "FCDqSkLENFyZ6KJUsUhj",
                "GMAaQlG7iE28JA7m3SBr",
                "6JY0EcFVopITkzsfDsGp"
              ]
            }
          ]
        }
