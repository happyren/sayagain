        "docent": {
          "note": "one route per upstream: /mcp/<name> over HTTP, or the stdio shim",
          "intents": [
            "one route per upstream: /mcp/<name> over HTTP, or the stdio shim",
            "relays initialize, tools/list, resources and prompts verbatim; announces itself only in _meta"
          ],
          "logic": "key(host) == key(upstream); never rename or prefix tools"
        }
      }
