      "link": null,
      "locked": false,
      "customData": {
        "docent": {
          "narrative": "One command reads the host's own configuration, registers every upstream, and rewrites each entry to point at the boundary under the same key. The original file is backed up first and eject restores it.",
          "order": 2
        }
      },
      "name": "01 Adopt"
    },
