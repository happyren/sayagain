{
  "name": "@sayagain/proxy",
  "version": "0.20.0",
  "description": "Say Again: the commitment boundary for MCP tool calls. wrap, daemon, receipts, dedupe, holds, repair, dead-letter and replay.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.ui.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:ui": "tsc -p tsconfig.ui.json"
  },
  "dependencies": {
    "@sayagain/sdk": "workspace:*",
    "@sayagain/lint": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/happyren/sayagain",
    "directory": "packages/proxy"
  },
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "sayagain": "./dist/cli.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent",
    "tool-calls",
    "proxy",
    "dead-letter",
    "idempotency"
  ]
}
